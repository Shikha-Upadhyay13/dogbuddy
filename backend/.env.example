OPENAI_API_KEY=
PARALLEL_API_KEY=
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
DATABASE_URL=postgresql+psycopg://dogbuddy:dogbuddy@localhost:5432/dogbuddy
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set to 1 only in local/test so password-reset responses include the OTP.
DOGBUDDY_DEBUG_OTP=0

# --- LangSmith tracing ---
# Get LANGSMITH_API_KEY from https://smith.langchain.com/settings (Personal -> Create API Key)
# When LANGSMITH_TRACING=true, every agent run + LLM call + tool call is sent to the
# project named below. No code changes required -- LangChain auto-instruments.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dogbuddy
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
